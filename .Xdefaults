Xft.dpi: 92
Xft.autohint: 0
Xft.lcdfilter: lcddefault
Xft.hintstyle: hintslight
Xft.hinting: 1
Xft.antialias: 1
Xft.rgba: rgb

urxvt*font: xft:JetBrains Mono:style=Regular:pixelsize=12, xft:Monaco for Powerline:pixelsize=12, xft:Monaco:pixelsize=12
urxvt.utf8: true
urxvt.locale: true
urxvt.letterSpace: 0

urxvt*transparent:true
urxvt*shading:80
urxvt*background:Black

urxvt*foreground: White
urxvt*geometry: 280x224
urxvt*cursorBlink: true
urxvt*cursorColor: #5eff24
urxvt*saveLines: 20000
urxvt*scrollBar:         false

! Extensions
URxvt.perl-lib: /home/gogoprog/scripts
URxvt.perl-ext: default,matcher-hover,mark-yank-urls
URxvt.underlineURLs: true
URxvt.keysym.C-i: perl:mark-yank-urls:activate_mark_mode
URxvt.urlLauncher: /usr/bin/xdg-open
URxvt.url-launcher: /usr/bin/xdg-open
URxvt.matcher-hover.button: 1
URxvt.matcher-hover.rend.0: Uline
! File paths (abs, ~/, ./, ../, rel/with/slash, bare name.ext) with optional :line:col -> nvim
URxvt.matcher-hover.pattern.1:  (?<![\\w/.:~@+-])((?:~|\\.{1,2})?/[\\w.+@-]+(?:/[\\w.+@-]+)*|[\\w.+@-]+(?:/[\\w.+@-]+)+|[\\w+@-][\\w.+@-]*\\.[A-Za-z]\\w{0,9})(?::(\\d+))?(?::(\\d+))?
URxvt.matcher-hover.launcher.1: /home/gogoprog/scripts/urxvt-open-path $1 $2 $3

! Keys
urxvt.keysym.C-Tab: \033{
!urxvt.keysym.Control-i: \033}
!urxvt.keysym.Shift-ISO_Left_Tab: \033}
urxvt.keysym.Control-Shift-F: \033]
urxvt*iso14755: False
urxvt*iso14755_52: False

URxvt*scrollTtyOutput:      false
URxvt*scrollWithBuffer:     true
URxvt*scrollTtyKeypress:    true
